# Local-only material: licensed PDFs, source documents, and anything carrying
# personal contact details. Nothing under private/ is ever committed.
private/

# Dataset. Fetched by scripts/download_dataset.py; never vendored into git --
# the images belong to their original publisher, not to this project's licence.
data/

# Model artefacts and raw prediction dumps. Regenerated by a run; too large and
# too machine-specific to version.
*.weights.h5
*.keras
*.npy

# Run outputs. results/baseline_run/ is the one committed exception: it holds the
# recorded numbers the README figures are rendered from, so it must stay in git.
# These rules come last so they win over the artefact patterns above.
results/*
!results/baseline_run/
!results/baseline_run/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
