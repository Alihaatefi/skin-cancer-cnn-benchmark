# Local-only material: licensed PDFs, source documents, and anything carrying
# personal contact details. Nothing under private/ is ever committed.
private/

# Dataset. Fetched by scripts/download_dataset.py; never vendored into git --
# the images belong to their original publisher, not to this project's licence.
data/

# Model artefacts and raw prediction dumps. Regenerated by a run; too large and
# too machine-specific to version.
*.weights.h5
*.keras
*.npy

# Run outputs. Committed exceptions: results/baseline_run/ (the recorded baseline the
# README figures were first rendered from), the full-benchmark table
# (results/benchmark.{md,csv}, which scripts/render_figures.py reads), the environment
# captured at launch, and each architecture's results.json (per-fold scorecards,
# histories and run manifest). Weights and .npy score dumps inside those directories
# stay ignored by the artefact patterns above. These rules come last so they win.
results/*
!results/baseline_run/
!results/baseline_run/**
!results/benchmark.md
!results/benchmark.csv
!results/benchmark_environment.txt
!results/*/
!results/*/results.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
